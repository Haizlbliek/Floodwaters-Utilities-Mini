		<Reference Include="$(RWPath)/RainWorld_Data/Managed/Assembly-CSharp-firstpass.dll"><Private>false</Private></Reference>
		<Reference Include="$(RWPath)/RainWorld_Data/Managed/PUBLIC-Assembly-CSharp.dll"><Private>false</Private></Reference>
		<Reference Include="$(RWPath)/RainWorld_Data/Managed/UnityEngine.dll"><Private>false</Private></Reference>
		<Reference Include="$(RWPath)/RainWorld_Data/Managed/Unity.Mathematics.dll"><Private>false</Private></Reference>
