<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
		<PathMap>$(MSBuildProjectDirectory)=.</PathMap>

		<OutputDirectory>../Floodwaters-Utilities-Mini/plugins</OutputDirectory>
	</PropertyGroup>

	<Target Name="CopyData" AfterTargets="AfterBuild">
		<Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(OutputDirectory)" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(OutputDirectory)" />
	</Target>

	<ItemGroup>
		<Compile Remove="assets\**\*" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="$(RainWorldDllPath)/Mono.Cecil.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/MonoMod.Common.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/MonoMod.RuntimeDetour.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/MonoMod.Utils.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/Assembly-CSharp-firstpass.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/PUBLIC-Assembly-CSharp.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/UnityEngine.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/Unity.Mathematics.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/UnityEngine.CoreModule.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/UnityEngine.InputLegacyModule.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldDllPath)/UnityEngine.AssetBundleModule.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldBepInEx)/core/BepInEx.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldBepInEx)/plugins/HOOKS-Assembly-CSharp.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldBepInEx)/utils/PUBLIC-Assembly-CSharp.dll"><Private>false</Private></Reference>
		<Reference Include="$(RainWorldBepInEx)/core/0Harmony.dll"><Private>false</Private></Reference>
	</ItemGroup>
</Project>
